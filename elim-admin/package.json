{
  "name": "elim-admin",
  "version": "2.3.2",
  "engines": {
    "node": "^22.22.0 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "generate": "node scripts/generate-version.mjs && node scripts/generate-calendars.mjs",
    "calendars": "node scripts/generate-calendars.mjs",
    "postinstall": "node scripts/generate-version.mjs",
    "prestart": "npm run generate",
    "start": "ng serve",
    "prebuild": "npm run generate",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/generate-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/service-worker": "^22.1.6",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
